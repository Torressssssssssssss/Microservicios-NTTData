        {
          "name": "00 - Inicializar CSRF y variables",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "postman-course-36"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/csrf"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Correlation returned\", function () { pm.expect(pm.response.headers.get(\"X-Correlation-Id\")).to.eql(\"postman-course-36\"); });",
                  "pm.collectionVariables.set(\"csrfToken\", pm.response.json().token);",
                  "pm.collectionVariables.set(\"username\", \"student_\" + Date.now());",
                  "pm.collectionVariables.set(\"email\", pm.collectionVariables.get(\"username\") + \"@example.test\");",
                  "pm.collectionVariables.set(\"checkoutKey\", \"checkout_\" + Date.now());"
                ]
              }
            }
          ]
        },

{
  "info": {
    "name": "TacoCloud - 36 retos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar la carpeta Flujo USER en orden. Postman debe conservar cookies. Las carpetas ADMIN/KITCHEN requieren la clave local de .runtime/lab.env en sus variables. Para cocina crear una orden adicional sin cancelarla. Las pruebas de concurrencia, broker, rollback, contratos y CI se ejecutan con scripts/verificar-retos.sh; no se sustituyen con esta coleccion."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "password",
      "value": "class-postman-password-123"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "kitchenPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Flujo USER",
